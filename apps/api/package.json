{
  "name": "@rokai/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch --env-file-if-exists=../../.env --experimental-transform-types src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "create-user": "npm run build && node --env-file-if-exists=../../.env dist/cli/create-user.js",
    "test": "npm run build && node --test --test-concurrency=1 --env-file-if-exists=../../.env dist/**/*.test.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.7",
    "@rokai/contracts": "*",
    "@rokai/db": "*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@rokai/config": "*",
    "@types/node": "^22.18.12",
    "@types/pg": "^8.15.6",
    "typescript": "^5.9.3"
  }
}
